# Copy to .env and fill in. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Frontend origins allowed to call the API (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Production example:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=shaikhibburrahaman.com,www.shaikhibburrahaman.com
# CORS_ALLOWED_ORIGINS=https://shaikhibburrahaman.com,https://www.shaikhibburrahaman.com
# CSRF_TRUSTED_ORIGINS=https://shaikhibburrahaman.com,https://www.shaikhibburrahaman.com

# Contact form rate limit per IP (DRF format) and number of reverse proxies in front of Django
CONTACT_THROTTLE_RATE=5/hour
NUM_PROXIES=1
